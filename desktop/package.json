{
  "name": "astrotip-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AstroLife React mission-control desktop interface",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm:dev:electron\"",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "tsc -b && vite build",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "bridge:proof": "node scripts/bridge-proof.mjs",
    "package:backend": "node scripts/build-backend.mjs",
    "package:dir": "npm run build && npm run package:backend && electron-builder --dir"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.552.0",
    "maath": "^0.10.8",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.0.12",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.0.14",
    "wait-on": "^9.0.3"
  },
  "overrides": { "minimatch": "^11.0.1" },
  "build": {
    "appId": "org.astrotip.desktop",
    "productName": "AstroLife",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "extraResources": [
      { "from": "../software", "to": "software", "filter": ["astrotip/**/*", "resources/**/*"] },
      { "from": "sidecar-dist/astrotip-backend", "to": "astrotip-backend" }
    ],
    "mac": { "category": "public.app-category.medical", "target": ["dir"], "icon": "build/icon.png" }
  }
}
